# Steam refresh token (SteamClient platform) produced by `npm run auth`.
# Leave empty here. On DIGITALY Cloud, set it as an environment variable in the dashboard.
STEAM_REFRESH_TOKEN=
# Steam App ID to report as played (2200 = Quake III Arena).
STEAM_APP_ID=2200
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Status while idling: online | away | invisible | offline. Steam shows the game only when not invisible/offline.
STEAM_PERSONA=online
# Where rotated tokens are stored locally. Not durable on DIGITALY Cloud (see docs/DEPLOYMENT.md).
SESSION_FILE=./data/session.json
# Ask Steam to renew the refresh token on logon. Keep false unless SESSION_FILE is durable storage:
# a renewed token invalidates the previous one.
STEAM_RENEW_REFRESH_TOKENS=false
